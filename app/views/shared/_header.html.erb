<header class="site-header">
  <%= link_to "Maintenance", root_path, class: "brand" %>
  <% if Current.user %>
    <nav>
      <%= link_to "Parc", equipments_path %>
      <% if policy(:admin).access? %>
        <%= link_to "Administration", admin_departments_path %>
      <% end %>
    </nav>
    <div class="user">
      <span><%= Current.user.name %></span>
      <%= button_to "Se déconnecter", session_path, method: :delete, class: "link-button" %>
    </div>
  <% end %>
</header>
